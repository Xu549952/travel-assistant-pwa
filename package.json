{
  "name": "travel-assistant-lhci",
  "version": "1.0.0",
  "description": "旅行助手 PWA - Lighthouse CI 自动化测试配置",
  "private": true,
  "scripts": {
    "lhci": "lhci",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:lighthouse": "lhci autorun",
    "test:lighthouse:mobile": "lhci autorun --collect.settings.preset=perf",
    "serve": "http-server . -p 8080 --cors -c-1",
    "serve:lhci": "npx http-server . -p 8080 --cors -c-1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@lhci/cli": "^0.13.0",
    "http-server": "^14.1.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lighthouse": "^11.0.0",
    "typescript": "^7.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "lib/**/*.js"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.1",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "capacitor-secure-storage-plugin": "^0.13.0"
  }
}
