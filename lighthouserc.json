{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8080/旅行助手.html"
      ],
      "numberOfRuns": 3,
      "startServerCommand": "npx http-server . -p 8080 --cors -c-1",
      "startServerReadyPattern": "Starting up http-server",
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-gpu",
        "maxWaitForLoad": 45000,
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo",
          "pwa"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.8 }],
        "categories:seo": ["warn", { "minScore": 0.8 }],
        "categories:pwa": ["warn", { "minScore": 0.7 }],
        "csp-xss": ["warn", { "minScore": 1 }],
        "uses-text-compression": ["warn", { "minScore": 1 }],
        "render-blocking-resources": ["warn", { "minScore": 0.9 }],
        "unused-javascript": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    },
    "server": {
      "port": 9001
    }
  }
}
